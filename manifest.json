{
  "manifest_version": 3,
  "name": "MyTems — Teams Lecture Companion",
  "version": "0.1.3",
  "description": "Free local lecture capture in Helium with on-demand OpenRouter/local AI notes, slide extraction, Exam Radar, and Notion export.",
  "permissions": [
    "tabCapture",
    "offscreen",
    "storage",
    "unlimitedStorage",
    "activeTab"
  ],
  "host_permissions": [
    "https://openrouter.ai/*",
    "https://ntfy.sh/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "optional_permissions": [
    "scripting"
  ],
  "optional_host_permissions": [
    "https://teams.microsoft.com/*",
    "https://teams.cloud.microsoft/*",
    "https://whiteboard.office.com/*",
    "https://*.whiteboard.microsoft.com/*"
  ],
  "background": {
    "service_worker": "src/background/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "MyTems Recorder",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
